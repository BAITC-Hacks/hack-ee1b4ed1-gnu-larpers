{
  "$schema": "https://turborepo.dev/schema.json",
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "//#data": {
      "inputs": ["backend/money_graph/**/*.py", "data/*.parquet", "backend/pyproject.toml", "backend/uv.lock"],
      "outputs": ["frontend/public/generated/**"]
    },
    "dev": {
      "dependsOn": ["//#data"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["//#data"],
      "outputs": ["dist/**"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "check": {},
    "//#check:python": {
      "cache": false
    }
  }
}
