{
  "name": "money-graph",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=11"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "check": "turbo run check check:python",
    "data": "uv run --frozen money-graph --data data --out frontend/public/generated",
    "check:python": "uv run --frozen ruff check . && uv run --frozen ruff format --check . && uv run --frozen pytest -q"
  },
  "devDependencies": {
    "turbo": "2.11.3"
  }
}
