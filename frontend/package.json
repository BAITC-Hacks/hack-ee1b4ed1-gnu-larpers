{
  "name": "money-graph-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/prepare-data.mjs",
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
